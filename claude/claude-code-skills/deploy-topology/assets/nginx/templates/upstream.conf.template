# Адрес бэкенда, DNS-сервер, доверенный прокси, размер загрузки и таймауты — всё, что зависит от среды.
# Без блока upstream: с ним nginx ищет адрес один раз при старте и падает, если бэкенда ещё нет.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

map $host $backend_upstream {
    default "${BACKEND_PROTOCOL}://${BACKEND_SERVICE}";
}

# Настоящий адрес клиента: X-Forwarded-For принимается только от этой сети
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Лимит согласуется с лимитом прокси перед этим контейнером: действует меньший
client_max_body_size ${MAX_BODY_SIZE};
client_body_timeout ${CLIENT_TIMEOUT};
send_timeout ${CLIENT_TIMEOUT};
proxy_connect_timeout ${BACKEND_TIMEOUT};
proxy_send_timeout ${BACKEND_TIMEOUT};
proxy_read_timeout ${BACKEND_TIMEOUT};
