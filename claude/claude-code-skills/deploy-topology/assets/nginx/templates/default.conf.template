
    # Content-Security-Policy — только из решений по безопасности архитектуры
    # (основа §1); в эталоне её нет. Если решение есть — добавить здесь
    # add_header Content-Security-Policy "…" always; иначе оставить как есть.

    root /usr/share/nginx/html;
    index index.html;

    # Максимальный размер загружаемого файла и таймауты — из NFR SRS (<<…>> подставляются при записи файла)
    client_max_body_size <<MAX_BODY_SIZE>>;
    client_body_buffer_size 128k;

    # Таймауты
    client_body_timeout <<CLIENT_TIMEOUT>>;
    client_header_timeout 120s;
    keepalive_timeout 65;
    send_timeout <<CLIENT_TIMEOUT>>;

    # Таймауты для бэкенда
    proxy_connect_timeout <<BACKEND_TIMEOUT>>;
    proxy_send_timeout <<BACKEND_TIMEOUT>>;
    proxy_read_timeout <<BACKEND_TIMEOUT>>;

    # Оптимизация производительности
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    types_hash_max_size 2048;

    large_client_header_buffers 4 32k;
    client_header_buffer_size 1k;

    # Настройки для ответов бэкенда
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    # Gzip сжатие
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml+rss
        application/rss+xml
        font/truetype
        font/opentype
        application/vnd.ms-fontobject
        image/svg+xml;
    gzip_min_length 1000;
    gzip_disable "msie6";

    # Безопасность - заголовки (усилены для HTTPS)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # location ^~ /swagger/ {
    #     proxy_pass ${BACKEND_PROTOCOL}://backend/swagger/;
    #     proxy_set_header Host $http_host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     # proxy_set_header X-Forwarded-Proto $scheme;
    #     proxy_set_header X-Forwarded-Host $http_host;
    #     proxy_set_header X-Forwarded-Port $server_port;
    #     proxy_pass_header Set-Cookie;
    #     proxy_set_header Cookie $http_cookie;
    #     proxy_redirect default;
    #     proxy_redirect ${BACKEND_PROTOCOL}://backend/ /;
    #     proxy_set_header X-Correlation-ID $http_x_correlation_id;
    #     proxy_set_header X-Request-ID $http_x_request_id;
    # }

    location /api/ {
        proxy_pass ${BACKEND_PROTOCOL}://backend/api/;
        # proxy_set_header Host $host;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_pass_header Set-Cookie;
        proxy_set_header Cookie $http_cookie;
        proxy_redirect default;
        proxy_redirect ${BACKEND_PROTOCOL}://backend/ /;
        # Передача correlation_id для трейсинга
        proxy_set_header X-Correlation-ID $http_x_correlation_id;
        proxy_set_header X-Request-ID $request_id;
    }

    # Статические файлы с хешами (JS, CSS, изображения, шрифты) - долгое кэширование
    location ~* \.(mjs|js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|otf)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # HTML файлы - без кэширования
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
        try_files $uri =404;
    }

    # Разрешить доступ к .well-known (используется Chrome DevTools, Let's Encrypt и др.)
    location ~ /\.well-known {
        allow all;
        access_log off;
        try_files $uri =404;
    }

    # Основной location для SPA
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
    }

    # Запрет доступа к скрытым файлам (кроме .well-known)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
